# ─────────────────────────────────────────────────────────────────────────────
# LOCAL STACK SECRETS — copy to `.env.stack` at the workspace root.
# Used by `local-dev env` to fill per-repo `.env` / `.env.local` files.
# Never commit `.env.stack`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared auth ──────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-key-here
INTERNAL_SECRET_KEY=your-internal-secret-key-here

# ── Postgres (stage RX is typical for local cross-service work) ─────────────
# capabilities-ai main DB (port 25001 on stage)
DB_CONNECTION_STRING=postgresql://postgres:PASSWORD@52.39.160.45:25001/postgres
# document-manager DB (port 27001 on stage) — required by capabilities + core-engine
DB_CONNECTION_STRING_DOC_MANAGER=postgresql://postgres:PASSWORD@52.39.160.45:27001/postgres
# core-engine main DB (port 26001 on stage)
DB_CONNECTION_STRING_CORE_ENGINE=postgresql://postgres:PASSWORD@52.39.160.45:26001/postgres

# Aliases used by core-engine (.env uses these names)
DB_CONNECTION_STRING_CAPABILITIES_AI=${DB_CONNECTION_STRING}
# core-engine primary DB — same as DB_CONNECTION_STRING_CORE_ENGINE
DB_CONNECTION_STRING=${DB_CONNECTION_STRING_CORE_ENGINE}

# ── Doc manager / RAG (stage or local if you run document-manager) ───────────
DOC_MANAGER_URL=https://docs-admin-be-stage.healthbackend.com/inference
RAG_URL=

# ── AI / voice (minimum to pass core-engine boot validation) ───────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
TTS_PROVIDER=cartesia
BRAVE_API_KEY=
MAPS_API_KEY=

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Twilio / Telnyx ──────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TELNYX_API_KEY=

# ── Other required capabilities keys ─────────────────────────────────────────
CANDOR_API_BASE_URL=https://analytics.candorhealth.com/api
CANDOR_API_KEY=
VERIFIED_API_KEY=
VERIFIED_API_URL=https://core-api.sandbox-verifiedinc.com/v2
GOODRX_API_KEY=
GOODRX_SECRET_KEY=
GOODRX_BASE_URL=https://api.goodrx.com
RESEND_API_KEY=
SERIF_API_KEY=
SERIF_API_BASE_URL=https://find-care.serifhealth.com/api/v1
STEDI_API_KEY=
SALESFORCE_SERVER_KEY=
SALESFORCE_URL=https://login.salesforce.com
SALESFORCE_CONSUMER_KEY=
SALESFORCE_USERNAME=

# ── App labels (shows up in Slack error tags) ────────────────────────────────
ENV=DEV
APP_NAME=capabilities-ai
